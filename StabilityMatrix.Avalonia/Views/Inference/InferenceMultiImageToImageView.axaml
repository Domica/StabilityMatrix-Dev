<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceMultiImageToImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dock="clr-namespace:StabilityMatrix.Avalonia.Controls.Dock"
    xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:modelsInference="clr-namespace:StabilityMatrix.Avalonia.Models.Inference"
    xmlns:avconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DataContext="{x:Static mocks:DesignData.InferenceMultiImageToImageViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    x:DataType="inference:InferenceMultiImageToImageViewModel"
    Focusable="True"
    mc:Ignorable="d">

    <controls:UserControlBase.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter" />
    </controls:UserControlBase.Resources>

    <Grid Margin="2,0,2,8">
        <DockControl
            x:Name="Dock"
            InitializeFactory="True"
            InitializeLayout="True">
            <DockControl.Factory>
                <Factory />
            </DockControl.Factory>

            <RootDock
                x:Name="Root"
                DefaultDockable="{Binding #MainLayout}"
                Id="Root"
                IsCollapsable="False">

                <ProportionalDock
                    x:Name="MainLayout"
                    Id="MainLayout"
                    Orientation="Horizontal">

                    <!--  Left Pane  -->
                    <ToolDock
                        x:Name="ConfigPane"
                        Alignment="Left"
                        Id="ConfigPane"
                        Proportion="0.2">
                        <Tool
                            x:Name="ConfigTool"
                            Title="Config"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ConfigTool">
                            <controls:StackCard DataContext="{ReflectionBinding ElementName=Dock, Path=DataContext.StackCardViewModel}" Opacity="1" />
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter1" Id="Splitter1" />

                    <!--  Prompt Pane  -->
                    <ProportionalDock
                        x:Name="CenterProportionalDock"
                        Id="CenterProportionalDock"
                        Orientation="Vertical">

                        <!--  Center Top (Reference images)  -->
                        <ToolDock
                            x:Name="ImagePane"
                            Alignment="Left"
                            Id="ImagePane"
                            Proportion="0.42">
                            <Tool
                                x:Name="ImageTool"
                                Title="Reference Images"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="ImageTool">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Grid
                                        x:CompileBindings="False"
                                        DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                        Opacity="1"
                                        RowDefinitions="Auto,Auto,Auto,Auto">

                                        <!--  Header: add / remove / reorder  -->
                                        <controls:Card Grid.Row="0" Margin="0,0,0,4" Padding="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="Reference images" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ReferenceCountText}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="2,0"
                                                    Padding="8,4"
                                                    Command="{Binding AddReferenceImagesCommand}"
                                                    Content="Add"
                                                    ToolTip.Tip="Add one or more reference images (up to 10)" />
                                                <Button
                                                    Grid.Column="3"
                                                    Margin="2,0"
                                                    Padding="8,4"
                                                    Command="{Binding RemoveSelectedReferenceCommand}"
                                                    Content="Remove" />
                                                <Button
                                                    Grid.Column="4"
                                                    Margin="2,0"
                                                    Padding="8,4"
                                                    Command="{Binding MoveSelectedReferenceUpCommand}"
                                                    Content="Up" />
                                                <Button
                                                    Grid.Column="5"
                                                    Margin="2,0"
                                                    Padding="8,4"
                                                    Command="{Binding MoveSelectedReferenceDownCommand}"
                                                    Content="Down" />
                                            </Grid>
                                        </controls:Card>

                                        <!--  Optional custom workflow JSON  -->
                                        <controls:Card Grid.Row="1" Margin="0,0,0,4" Padding="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="Custom workflow (optional)" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding WorkflowPath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding WorkflowPath}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="2,0"
                                                    Padding="8,4"
                                                    Command="{Binding SelectWorkflowCommand}"
                                                    Content="Browse..."
                                                    ToolTip.Tip="For exact face identity, load a ComfyUI API workflow built on a real multi-image edit model (Z-Image-Edit / Qwen-Image-Edit / FLUX.2). Placeholders: @SM_REF_0..9, @SM_REFS, {SM_PROMPT}." />
                                                <Button
                                                    Grid.Column="3"
                                                    Padding="8,4"
                                                    Command="{Binding ClearWorkflowCommand}"
                                                    Content="Clear"
                                                    ToolTip.Tip="Go back to the built-in Florence-2 reference-to-prompt graph" />
                                            </Grid>
                                        </controls:Card>

                                        <StackPanel Grid.Row="2" Margin="4,0,4,6" Spacing="6">
                                            <TextBlock
                                                Opacity="0.9"
                                                Text="{Binding GraphModeText}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Opacity="0.65"
                                                Text="Add 1-10 character references, write what the group should do in the prompt, and optionally mark one image as the environment/scene. Each reference can carry its own short note (role, side, etc.) so Z-Image knows what to align."
                                                TextWrapping="Wrap" />

                                            <!--  Optional environment / scene reference  -->
                                            <controls:Card Padding="8" IsVisible="{Binding !HasWorkflow}">
                                                <Grid ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="6">
                                                    <Image
                                                        Grid.Column="0"
                                                        Width="48"
                                                        Height="48"
                                                        Source="{Binding EnvironmentReferencePath, Converter={StaticResource PathToImageConverter}}"
                                                        Stretch="UniformToFill" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="Scene / environment (optional)" />
                                                        <TextBox
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Watermark="scene note, e.g. 'warm living room, evening'"
                                                            Text="{Binding EnvironmentNote}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Opacity="0.7"
                                                            Text="{Binding EnvironmentReferencePath}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding EnvironmentReferencePath}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Margin="2,0"
                                                        Padding="8,4"
                                                        Command="{Binding SetEnvironmentReferenceCommand}"
                                                        Content="Browse..."
                                                        ToolTip.Tip="Pick ONE image for the room/scene/background. The other references are treated as people; your prompt controls where they sit." />
                                                    <Button
                                                        Grid.Column="3"
                                                        Padding="8,4"
                                                        Command="{Binding ClearEnvironmentReferenceCommand}"
                                                        Content="Clear" />
                                                </Grid>
                                            </controls:Card>

                                            <!--  Context-aware fusion controls (hidden when a custom workflow is active)  -->
                                            <controls:Card Padding="8" IsVisible="{Binding !HasWorkflow}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <ToggleSwitch
                                                            Grid.Column="0"
                                                            IsChecked="{Binding UseContextualFusion}"
                                                            OffContent="Context-aware fusion OFF"
                                                            OnContent="Context-aware fusion ON" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Padding="8,4"
                                                            Command="{Binding RefreshCaptionsCommand}"
                                                            Content="Refresh descriptions"
                                                            IsEnabled="{Binding !IsReadingCaptions}"
                                                            ToolTip.Tip="Re-read the reference images with Florence-2 (clears the cache)" />
                                                    </Grid>

                                                    <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,*">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Text="Description detail" />
                                                        <ComboBox
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            SelectedIndex="{Binding CaptionDetailIndex}"
                                                            ToolTip.Tip="How thoroughly Florence-2 describes each reference. Rich (default) adds a full paragraph; Maximum also lists detected people, clothing and objects. Higher levels take longer on the first Generate, then stay cached.">
                                                            <ComboBoxItem Content="Standard — one short caption (fastest)" />
                                                            <ComboBoxItem Content="Rich — full paragraph + key details" />
                                                            <ComboBoxItem Content="Maximum — also detected regions (slowest)" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,*">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Text="Images / panels" />
                                                        <ComboBox
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            SelectedIndex="{Binding OutputPanelIndex}"
                                                            ToolTip.Tip="How many images (or panels) to produce, 1-6.">
                                                            <ComboBoxItem Content="1" />
                                                            <ComboBoxItem Content="2" />
                                                            <ComboBoxItem Content="3" />
                                                            <ComboBoxItem Content="4" />
                                                            <ComboBoxItem Content="5" />
                                                            <ComboBoxItem Content="6" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <CheckBox
                                                        Margin="0,4,0,0"
                                                        Content="Arrange as a grid of panels in ONE image"
                                                        IsChecked="{Binding ArrangeAsGrid}"
                                                        ToolTip.Tip="Off (default): generate N separate complete images, each a single undivided scene — no grid. On: generate ONE image containing exactly N clean panels. This control is authoritative on this screen; the generic Batch Size card is not used." />

                                                    <TextBlock
                                                        Opacity="0.8"
                                                        Text="{Binding FusionModeText}"
                                                        TextWrapping="Wrap" />

                                                    <StackPanel
                                                        Spacing="2"
                                                        IsVisible="{Binding ContextSummary, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="How the prompt was interpreted:" />
                                                        <TextBlock
                                                            Opacity="0.8"
                                                            Text="{Binding ContextSummary}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            FontWeight="SemiBold"
                                                            Text="Reference descriptions (Florence-2, detail level applies):" />
                                                        <ProgressBar
                                                            Grid.Column="1"
                                                            Width="90"
                                                            IsIndeterminate="True"
                                                            IsVisible="{Binding IsReadingCaptions}" />
                                                    </Grid>
                                                    <TextBox
                                                        MinHeight="140"
                                                        MaxHeight="300"
                                                        AcceptsReturn="True"
                                                        IsReadOnly="True"
                                                        Text="{Binding CaptionsText}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </controls:Card>

                                            <!--  Composed prompt: the exact text sent to Z-Image  -->
                                            <controls:Card
                                                Padding="8"
                                                IsVisible="{Binding ComposedPrompt, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}">
                                                <Grid RowDefinitions="Auto,Auto">
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Margin="0,0,0,2"
                                                        FontWeight="SemiBold"
                                                        Text="Prompt sent to Z-Image (verify your instruction is honoured):" />
                                                    <TextBox
                                                        Grid.Row="1"
                                                        MinHeight="90"
                                                        AcceptsReturn="True"
                                                        IsReadOnly="True"
                                                        Text="{Binding ComposedPrompt}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </controls:Card>
                                        </StackPanel>

                                        <!--  Thumbnails (each reference carries its own note / role)  -->
                                        <ListBox
                                            Grid.Row="3"
                                            ItemsSource="{Binding ReferenceImagePaths}"
                                            SelectedItem="{Binding SelectedReferenceItem}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="3"
                                                        Padding="4"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <StackPanel Width="150" Spacing="4">
                                                            <Image
                                                                Width="142"
                                                                Height="116"
                                                                Source="{Binding Path, Converter={StaticResource PathToImageConverter}}"
                                                                Stretch="UniformToFill" />
                                                            <TextBox
                                                                Watermark="note / role (optional)"
                                                                Text="{Binding Note}"
                                                                ToolTip.Tip="{Binding Path}"
                                                                FontSize="11"
                                                                TextWrapping="Wrap"
                                                                AcceptsReturn="True"
                                                                MaxHeight="52" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </ScrollViewer>
                            </Tool>
                        </ToolDock>

                        <ProportionalDockSplitter />

                        <!--  Center Bottom (Prompt)  -->
                        <ToolDock
                            x:Name="PromptPane"
                            Alignment="Left"
                            Id="PromptPane"
                            Proportion="0.25">
                            <Tool
                                x:Name="PromptTool"
                                Title="Prompt"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="PromptTool">
                                <Grid
                                    x:CompileBindings="False"
                                    DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                    Opacity="1"
                                    RowDefinitions="*,Auto,Auto">
                                    <controls:PromptCard DataContext="{Binding PromptCardViewModel}" />

                                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                        <controls:Card Padding="8">
                                            <Grid
                                                HorizontalAlignment="Center"
                                                ColumnDefinitions="Auto,*,Auto"
                                                RowDefinitions="Auto,*">
                                                <Grid.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="MinHeight" Value="32" />
                                                    </Style>
                                                </Grid.Styles>
                                                <Button
                                                    Grid.Row="1"
                                                    Margin="4,0"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    icons:Attached.Icon="fa-solid fa-magnifying-glass-plus"
                                                    Classes="transparent"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.HiresFixAndUseCurrentSeed}"
                                                    ToolTip.Tip="Generate with Hires Scaling" />

                                                <Button
                                                    x:Name="GenerateButton"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="130"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="accent"
                                                    HotKey="Ctrl+Enter"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.None}"
                                                    IsVisible="{Binding !GenerateImageCommand.CanBeCanceled}"
                                                    ToolTip.Tip="{Binding $self.HotKey}">
                                                    <Panel>
                                                        <TextBlock IsVisible="{Binding #GenerateButton.IsEnabled}" Text="Generate Image" />
                                                        <controls:ProgressRing IsIndeterminate="True" IsVisible="{Binding !#GenerateButton.IsEnabled}" />
                                                    </Panel>
                                                </Button>

                                                <Button
                                                    x:Name="CancelButton"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="130"
                                                    HorizontalAlignment="Stretch"
                                                    icons:Attached.Icon="fa-solid fa-stop"
                                                    Command="{Binding GenerateImageCancelCommand}"
                                                    IsVisible="{Binding GenerateImageCommand.CanBeCanceled}" />

                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="4,0"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    icons:Attached.Icon="fa-solid fa-repeat"
                                                    Classes="transparent"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.UseCurrentSeed}"
                                                    ToolTip.Tip="Generate with current seed" />
                                            </Grid>
                                        </controls:Card>
                                    </StackPanel>
                                </Grid>
                            </Tool>
                        </ToolDock>

                    </ProportionalDock>

                    <ProportionalDockSplitter x:Name="Splitter2" Id="Splitter2" />

                    <!--  Middle Right Pane  -->
                    <ToolDock
                        x:Name="ImageGalleryPane"
                        Alignment="Right"
                        Id="ImageGalleryPane"
                        Proportion="0.35">
                        <Tool
                            x:Name="ImageGalleryTool"
                            Title="Image Output"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageGalleryTool">
                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageGalleryCard Grid.Row="0" DataContext="{Binding ImageGalleryCardViewModel}" />

                                <StackPanel
                                    Margin="2,1,2,4"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding OutputProgress}"
                                    Spacing="4">
                                    <ProgressBar
                                        IsIndeterminate="{Binding IsIndeterminate}"
                                        IsVisible="{Binding IsProgressVisible}"
                                        Maximum="{Binding Maximum}"
                                        Value="{Binding Value}" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding IsTextVisible}"
                                        Text="{Binding Text}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter3" Id="Splitter3" />

                    <!--  Right Pane  -->
                    <ToolDock
                        x:Name="ImageFolderPane"
                        Alignment="Right"
                        Id="ImageFolderPane"
                        Proportion="0.1">
                        <Tool
                            x:Name="ImageFolderTool"
                            Title="Gallery"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageFolderTool">
                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageFolderCard DataContext="{Binding ImageFolderCardViewModel}" />
                            </Grid>
                        </Tool>
                    </ToolDock>

                </ProportionalDock>
            </RootDock>

        </DockControl>
    </Grid>
</controls:UserControlBase>
