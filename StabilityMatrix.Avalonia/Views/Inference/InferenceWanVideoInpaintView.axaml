<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceWanVideoInpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:modelsInference="clr-namespace:StabilityMatrix.Avalonia.Models.Inference"
    d:DataContext="{x:Static mocks:DesignData.InferenceWanVideoInpaintViewModel}"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    x:DataType="inference:InferenceWanVideoInpaintViewModel"
    mc:Ignorable="d">
    <Grid Margin="2,0,2,8">
        <DockControl
            x:Name="Dock"
            InitializeFactory="True"
            InitializeLayout="True">
            <DockControl.Factory>
                <Factory />
            </DockControl.Factory>

            <RootDock
                x:Name="Root"
                DefaultDockable="{Binding #MainLayout}"
                Id="Root"
                IsCollapsable="False">

                <ProportionalDock
                    x:Name="MainLayout"
                    Id="MainLayout"
                    Orientation="Horizontal">

                    <!--  Left Pane  -->
                    <ToolDock
                        x:Name="ConfigPane"
                        Alignment="Left"
                        Id="ConfigPane"
                        Proportion="0.2">
                        <Tool
                            x:Name="ConfigTool"
                            Title="Config"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ConfigTool">
                            <controls:StackCard DataContext="{ReflectionBinding ElementName=Dock, Path=DataContext.StackCardViewModel}" Opacity="1" />
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter1" Id="Splitter1" />

                    <!--  Prompt Pane  -->
                    <ProportionalDock
                        x:Name="CenterProportionalDock"
                        Id="CenterProportionalDock"
                        Orientation="Vertical">

                        <!--  Center Top (Video + Mask)  -->
                        <ToolDock
                            x:Name="VideoMaskPane"
                            Alignment="Left"
                            Id="VideoMaskPane"
                            Proportion="0.45">
                            <Tool
                                x:Name="VideoMaskTool"
                                Title="Video &amp; Mask"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="VideoMaskTool">

                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <Grid
                                        x:CompileBindings="False"
                                        Margin="0,0,8,8"
                                        DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                        Opacity="1"
                                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <!--  Input video selector  -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        ColumnDefinitions="*,Auto">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock
                                                Text="{Binding VideoInputPath, FallbackValue='No video selected'}"
                                                TextWrapping="Wrap"
                                                ToolTip.Tip="Input video for inpainting"
                                                Foreground="#cccccc" />
                                            <TextBlock
                                                Text="Input Video"
                                                FontSize="11"
                                                Foreground="#888888" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            HorizontalAlignment="Right"
                                            Classes="accent"
                                            avalonia:Attached.Icon="fa-solid fa-folder-open"
                                            Command="{Binding BrowseVideoCommand}"
                                            ToolTip.Tip="Select input video file" />
                                    </Grid>

                                    <!--  Mask mode + SAM2 settings  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Spacing="6">
                                        <ToggleSwitch
                                            IsChecked="{Binding UseSam2Tracking}"
                                            OffContent="Manual mask (white = replace, same mask on every frame)"
                                            OnContent="Auto mask: click the object, SAM2 tracks it through the video" />

                                        <StackPanel
                                            IsVisible="{Binding !UseSam2Tracking}"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#888888"
                                                Text="Click 'Edit mask', paint the part to replace in WHITE and press Save, then check 'Preview manual mask'. Alternatively load a black/white mask PNG, or a frame with a solid WHITE area painted over the face. White = replace, black = keep; the same static mask is used on every frame."
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Padding="12,6"
                                                    Classes="accent"
                                                    Command="{Binding EditManualMaskCommand}"
                                                    Content="Edit mask (paint white)"
                                                    ToolTip.Tip="Open the mask editor for the loaded frame with masking enabled" />
                                                <Button
                                                    Padding="12,6"
                                                    Command="{Binding PreviewManualMaskCommand}"
                                                    Content="Preview manual mask"
                                                    ToolTip.Tip="Show the binary mask that will be uploaded (white = replace)" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel
                                            IsVisible="{Binding UseSam2Tracking}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Padding="12,6"
                                                Command="{Binding LoadFrameCommand}"
                                                Content="Load frame"
                                                IsEnabled="{Binding !IsLoadingFrame}"
                                                ToolTip.Tip="Extract the first frame of the video through ComfyUI" />
                                            <Button
                                                Padding="12,6"
                                                Command="{Binding PreviewMaskCommand}"
                                                Content="Preview mask"
                                                IsEnabled="{Binding !IsLoadingFrame}"
                                                ToolTip.Tip="Generate mask preview for first, middle, and last frame using SAM2" />
                                            <Button
                                                Padding="12,6"
                                                Command="{Binding UndoPointCommand}"
                                                Content="Undo point" />
                                            <Button
                                                Padding="12,6"
                                                Command="{Binding ClearPointsCommand}"
                                                Content="Clear points" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#8bc48b"
                                                Text="{Binding PointStatusText}" />
                                        </StackPanel>

                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#888888"
                                            IsVisible="{Binding UseSam2Tracking}"
                                            Text="Left click = replace this (green), right click = keep this (red). 3-8 green points inside the face/head are usually enough."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--  Advanced settings live below the clickable frame and are reached by scrolling  -->
                                    <StackPanel Grid.Row="3" Margin="0,0,0,8" Spacing="6">
                                        <StackPanel
                                            IsVisible="{Binding UseSam2Tracking}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="SAM2 model" />
                                            <ComboBox
                                                MinWidth="240"
                                                ItemsSource="{Binding Sam2ModelNames}"
                                                SelectedItem="{Binding Sam2ModelName}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="Precision"
                                                ToolTip.Tip="fp32 uses the checkpoint filename as-is; fp16 / bf16 make the SAM2 node look for *-fp16.safetensors" />
                                            <ComboBox
                                                MinWidth="100"
                                                ItemsSource="{Binding Sam2Precisions}"
                                                SelectedItem="{Binding Sam2Precision}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="Grow mask (px)"
                                                ToolTip.Tip="Positive expands the erased area (less original motion); negative shrinks the mask and keeps more of the original movement around the outline. Keep at 0 for a sharp outline." />
                                            <NumericUpDown
                                                Width="120"
                                                Maximum="128"
                                                Minimum="-64"
                                                Value="{Binding MaskGrow}" />
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleSwitch
                                                    IsChecked="{Binding EnableAutoPreserveMovement}"
                                                    OffContent="Preserve movement: manual (expert slider)"
                                                    OnContent="Preserve movement: AUTO"
                                                    ToolTip.Tip="AUTO picks a gentle 'keep original motion' strength (0.10-0.18) so the new face still replaces the old one while following some lip/head movement. The old 0.40 value restored too much of the original face and prevented any swap. The slider below stays as the expert override." />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#666666"
                                                    Text="{Binding MotionPreservationLabel}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="Keep original motion (expert)"
                                                    ToolTip.Tip="Feeds a fraction of the ORIGINAL face pixels back into the blanked region. 0 = frozen new face but strongest identity change; 0.10-0.20 = recommended; above ~0.30 VACE tends to reproduce the OLD face, so the swap appears to do nothing. 1 = original face exactly. Disabled while AUTO is on." />
                                                <NumericUpDown
                                                    Width="120"
                                                    FormatString="0.00"
                                                    Increment="0.05"
                                                    IsEnabled="{Binding !EnableAutoPreserveMovement}"
                                                    Maximum="1"
                                                    Minimum="0"
                                                    Value="{Binding MotionPreservation}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#888888"
                                                    Text="0 = frozen new face | 0.10-0.20 recommended | &gt;0.30 = old face returns (no swap)" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Split base: temporal chunking for videos too long for the GPU  -->
                                        <StackPanel Margin="0,4,0,0" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleSwitch
                                                    IsChecked="{Binding EnableChunkedProcessing}"
                                                    OffContent="Split base: OFF (whole video, one prompt)"
                                                    OnContent="Split base: ON (chunks one by one, then join)" />
                                                <Button
                                                    Padding="10,4"
                                                    Command="{Binding PreviewChunkPlanCommand}"
                                                    Content="Check plan"
                                                    ToolTip.Tip="Probe the input video and show the chunk plan without generating anything" />
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding EnableChunkedProcessing}" Spacing="6">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#888888"
                                                    Text="For videos the GPU cannot process in one go. Each chunk is a separate ComfyUI prompt so peak VRAM stays low; the MP4s are joined with ffmpeg into ONE video with the input's frame count, FPS and duration. Scene-cut protection keeps later scenes unchanged so SAM2 points are never re-seeded onto a different person."
                                                    TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox
                                                        VerticalAlignment="Center"
                                                        Content="Auto size (free VRAM)"
                                                        IsChecked="{Binding AutoChunkSize}"
                                                        ToolTip.Tip="Queries ComfyUI /system_stats for free VRAM and derives a safe frames-per-chunk value. Falls back to the manual value when unavailable." />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="Frames / chunk" />
                                                    <NumericUpDown
                                                        Width="110"
                                                        Increment="4"
                                                        IsEnabled="{Binding !AutoChunkSize}"
                                                        Maximum="161"
                                                        Minimum="5"
                                                        ToolTip.Tip="Wan VACE requires 4n+1 frames (5, 9, 17, 25, 49, 81 ...). The value is snapped down to the nearest valid length."
                                                        Value="{Binding ChunkFrames}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="Overlap"
                                                        ToolTip.Tip="Frames repeated between neighbouring chunks to hide temporal seams. Repeated frames are discarded before joining. 0 = exact and fastest." />
                                                    <NumericUpDown
                                                        Width="90"
                                                        Increment="4"
                                                        Maximum="64"
                                                        Minimum="0"
                                                        Value="{Binding ChunkOverlapFrames}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox
                                                        VerticalAlignment="Center"
                                                        Content="Scene-cut protection (SAM2)"
                                                        IsChecked="{Binding ProtectAgainstSceneCuts}"
                                                        ToolTip.Tip="Detects hard cuts with ffmpeg. Chunks outside the scene you clicked are generated with an empty mask, so the same green points cannot replace the wrong face after a scene change. Click 'Check plan' to see the detected cut frames." />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="Cut sensitivity"
                                                        ToolTip.Tip="ffmpeg scene score threshold. Lower = more cuts detected. If real cuts are missed, lower it (e.g. 0.15); if fast motion is mistaken for a cut, raise it (e.g. 0.40)." />
                                                    <NumericUpDown
                                                        Width="100"
                                                        Increment="0.05"
                                                        IsEnabled="{Binding ProtectAgainstSceneCuts}"
                                                        Maximum="0.90"
                                                        Minimum="0.05"
                                                        Value="{Binding SceneCutThreshold}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#666666"
                                                Text="{Binding ChunkPlanSummary}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Fixed height: the point picker must never be squeezed to 0 px
                                          by the settings above it, otherwise clicks are impossible.  -->
                                    <Grid
                                        Grid.Row="2"
                                        Height="240"
                                        Margin="0,4,0,8"
                                        ClipToBounds="True">
                                        <!--  Frame preview with click points (SAM2 mode)  -->
                                        <Grid IsVisible="{Binding UseSam2Tracking}">
                                            <Border
                                                Background="#1e1e1e"
                                                BorderBrush="#444444"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <controls:FramePointPicker
                                                x:CompileBindings="False"
                                                IsHitTestVisible="{Binding !IsFramePreviewMissing}"
                                                NegativePoints="{Binding NegativePoints}"
                                                PointClickedCommand="{Binding AddPointCommand}"
                                                PositivePoints="{Binding PositivePoints}"
                                                Source="{Binding FramePreview}" />
                                            <!--  Drawn last so it stays clickable while no frame exists  -->
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsFramePreviewMissing}"
                                                Spacing="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="#dddddd"
                                                    Text="No frame loaded" />
                                                <TextBlock
                                                    MaxWidth="300"
                                                    FontSize="11"
                                                    Foreground="#999999"
                                                    Text="Click 'Load frame', then LEFT-click 3-8 points inside the face/head you want to replace."
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    HorizontalAlignment="Center"
                                                    Padding="12,6"
                                                    Classes="accent"
                                                    Command="{Binding LoadFrameCommand}"
                                                    Content="Load frame"
                                                    IsEnabled="{Binding !IsLoadingFrame}" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  Manual mask image card (static mask)  -->
                                        <Grid IsVisible="{Binding !UseSam2Tracking}">
                                            <controls:SelectImageCard
                                                x:CompileBindings="False"
                                                DataContext="{Binding MaskImageCardViewModel}" />
                                        </Grid>
                                    </Grid>

                                    <!--  Mask previews. Kept in a separate row so they never replace
                                          the clickable frame / mask card above.  -->
                                    <StackPanel
                                        Grid.Row="4"
                                        Margin="0,6,0,0"
                                        Spacing="2">
                                        <StackPanel IsVisible="{Binding UseSam2Tracking}" Spacing="2">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#888888"
                                                Text="SAM2 mask preview (white = replace, black = keep)" />
                                            <ScrollViewer
                                                MaxHeight="130"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding MaskPreviewFrames}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image
                                                                Height="110"
                                                                Margin="4"
                                                                Source="{Binding}"
                                                                Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding !UseSam2Tracking}" Spacing="2">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#888888"
                                                Text="Manual mask preview (white = replace, black = keep)" />
                                            <Image
                                                MaxHeight="150"
                                                HorizontalAlignment="Left"
                                                Source="{Binding ManualMaskPreview}"
                                                Stretch="Uniform" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                            </Tool>
                        </ToolDock>

                        <ProportionalDockSplitter />

                        <!--  Center Middle (Reference Image)  -->
                        <ToolDock
                            x:Name="ReferencePane"
                            Alignment="Left"
                            Id="ReferencePane"
                            Proportion="0.2">
                            <Tool
                                x:Name="ReferenceTool"
                                Title="Reference Image (Optional)"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="ReferenceTool">

                                <Grid
                                    x:CompileBindings="False"
                                    DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                    Opacity="1"
                                    RowDefinitions="*">
                                    <!--  Reference image card  -->
                                    <controls:SelectImageCard
                                        x:CompileBindings="False"
                                        DataContext="{Binding ReferenceImageCardViewModel}" />
                                </Grid>

                            </Tool>
                        </ToolDock>

                        <ProportionalDockSplitter />

                        <!--  Center Bottom (Prompt)  -->
                        <ToolDock
                            x:Name="PromptPane"
                            Alignment="Left"
                            Id="PromptPane"
                            Proportion="0.25">
                            <Tool
                                x:Name="PromptTool"
                                Title="Prompt"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="PromptTool">

                                <!--  Prompt and buttons  -->
                                <Grid
                                    x:CompileBindings="False"
                                    DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                    Opacity="1"
                                    RowDefinitions="*,Auto,Auto">
                                    <!--  Prompt card  -->
                                    <controls:PromptCard DataContext="{Binding PromptCardViewModel}" />

                                    <!--  Generate Buttons  -->
                                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                        <controls:Card Padding="8">
                                            <Grid
                                                HorizontalAlignment="Center"
                                                ColumnDefinitions="Auto,*,Auto"
                                                RowDefinitions="Auto,*">
                                                <Grid.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="MinHeight" Value="32" />
                                                    </Style>
                                                </Grid.Styles>
                                                <Button
                                                    Grid.Row="1"
                                                    Margin="4,0"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    avalonia:Attached.Icon="fa-solid fa-magnifying-glass-plus"
                                                    Classes="transparent"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.HiresFixAndUseCurrentSeed}"
                                                    ToolTip.Tip="Generate with Hires Scaling" />

                                                <!--  Main Generate Button  -->
                                                <Button
                                                    x:Name="GenerateButton"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="130"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="accent"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.None}"
                                                    HotKey="Ctrl+Enter"
                                                    IsVisible="{Binding !GenerateImageCommand.CanBeCanceled}"
                                                    ToolTip.Tip="{Binding $self.HotKey}">
                                                    <Panel>
                                                        <TextBlock IsVisible="{Binding #GenerateButton.IsEnabled}" Text="Generate Video" />
                                                        <controls:ProgressRing IsIndeterminate="True" IsVisible="{Binding !#GenerateButton.IsEnabled}" />
                                                    </Panel>
                                                </Button>
                                                <!--  Cancel Button  -->
                                                <Button
                                                    x:Name="CancelButton"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="130"
                                                    HorizontalAlignment="Stretch"
                                                    avalonia:Attached.Icon="fa-solid fa-stop"
                                                    Command="{Binding GenerateImageCancelCommand}"
                                                    IsVisible="{Binding GenerateImageCommand.CanBeCanceled}" />

                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="4,0"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    avalonia:Attached.Icon="fa-solid fa-repeat"
                                                    Classes="transparent"
                                                    Command="{Binding GenerateImageCommand}"
                                                    CommandParameter="{x:Static modelsInference:GenerateFlags.UseCurrentSeed}"
                                                    ToolTip.Tip="Generate with current seed" />
                                            </Grid>
                                        </controls:Card>
                                    </StackPanel>
                                </Grid>

                            </Tool>
                        </ToolDock>

                    </ProportionalDock>


                    <ProportionalDockSplitter x:Name="Splitter2" Id="Splitter2" />

                    <!--  Middle Right Pane  -->
                    <ToolDock
                        x:Name="ImageGalleryPane"
                        Alignment="Right"
                        Id="ImageGalleryPane"
                        Proportion="0.35">
                        <Tool
                            x:Name="ImageGalleryTool"
                            Title="Video Output"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageGalleryTool">

                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageGalleryCard Grid.Row="0" DataContext="{Binding ImageGalleryCardViewModel}" />

                                <StackPanel
                                    Margin="2,1,2,4"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding OutputProgress}"
                                    Spacing="4">
                                    <ProgressBar
                                        IsIndeterminate="{Binding IsIndeterminate}"
                                        IsVisible="{Binding IsProgressVisible}"
                                        Maximum="{Binding Maximum}"
                                        Value="{Binding Value}" />

                                    <TextBlock
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding IsTextVisible}"
                                        Text="{Binding Text}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter3" Id="Splitter3" />

                    <!--  Right Pane  -->
                    <ToolDock
                        x:Name="ImageFolderPane"
                        Alignment="Right"
                        Id="ImageFolderPane"
                        Proportion="0.1">
                        <Tool
                            x:Name="ImageFolderTool"
                            Title="Gallery"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageFolderTool">

                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageFolderCard DataContext="{Binding ImageFolderCardViewModel}" />
                            </Grid>
                        </Tool>
                    </ToolDock>

                </ProportionalDock>
            </RootDock>
        </DockControl>
    </Grid>
</controls:UserControlBase>
