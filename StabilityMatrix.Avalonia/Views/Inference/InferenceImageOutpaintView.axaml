<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO (600px), DESNO (fleksibilno) -->
    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVO: fiksni panel 600x400 + scroll ispod -->
        <Grid Grid.Column="0" RowDefinitions="400,*" Margin="0,0,12,0">

            <!-- GORNJI DIO: slika u 600x400, shrink -->
            <Border 
                Width="600"
                Height="400"
                Background="#1E1E1E"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,8">

                <Image 
                    Source="{Binding SelectedImage}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="584"
                    MaxHeight="384" />
            </Border>

            <!-- DONJI DIO: StackCard scrollable -->
            <ScrollViewer 
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                
                <controls:StackCard 
                    DataContext="{Binding StackCardViewModel}" />
            </ScrollViewer>
        </Grid>

        <!-- DESNO: preview gore, generate dolje -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- PREVIEW (gore desno) -->
            <Border 
                Grid.Row="0"
                Width="400"
                Height="400"
                Background="#1E1E1E"
                CornerRadius="6"
                Padding="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,12">

                <Image 
                    Source="{Binding SelectedImage}"
                    Stretch="Uniform"
                    MaxWidth="384"
                    MaxHeight="384" />
            </Border>

            <!-- PRAZAN PROSTOR (nema galerije) -->
            <Grid Grid.Row="1" />

            <!-- GENERATE BUTTON (dolje desno) -->
            <Button 
                Grid.Row="2"
                HorizontalAlignment="Right"
                Width="160"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
