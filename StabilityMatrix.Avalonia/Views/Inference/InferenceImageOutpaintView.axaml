<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVO: Gornji fiksni + donji scroll -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">

            <!-- GORNJI LIJEVI KUT: Load Image (fiksno 600x400) -->
            <Border Width="600" Height="400"
                    Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8">
                <controls:LoadImageCard DataContext="{Binding LoadImageCardViewModel}" />
            </Border>

            <!-- DONJI DIO: Scrollable parametri + outpaint postavke -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <controls:StackCard DataContext="{Binding StackCardViewModel}" />
                    <TextBlock Text="Outpaint postavke (placeholder)" FontWeight="Bold" Margin="0,12,0,0" />
                    <!-- TODO: Dodati stvarne outpaint kontrole -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- DESNO: Preview gore, Generate dolje -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- PREVIEW GORE DESNO -->
            <Border Grid.Row="0"
                    Width="400" Height="400"
                    Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,0,12">
                <Image Source="{Binding SelectedImage}"
                       Stretch="Uniform"
                       MaxWidth="384"
                       MaxHeight="384" />
            </Border>

            <!-- PRAZAN SREDNJI DIO -->
            <Grid Grid.Row="1" />

            <!-- GENERATE GUMB DOLJE DESNO -->
            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    Width="160" Height="40"
                    Content="Generate Image"
                    Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
