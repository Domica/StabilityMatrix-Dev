<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO fiksno, DESNO fleksibilno -->
    <Grid ColumnDefinitions="600,*">

        <!-- ================= LEFT SIDE ================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="12">

            <!-- INPUT IMAGE PREVIEW (FIKSNO 600x400) -->
            <Border
                Width="600"
                Height="400"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">

                <Image
                    Stretch="Uniform"
                    Source="{Binding SelectedImage}" />
            </Border>

            <!-- STACK CARDS ISPOD PREVIEWA -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <controls:StackCard
                    DataContext="{Binding StackCardViewModel}" />
            </ScrollViewer>

        </Grid>

        <!-- ================= RIGHT SIDE ================= -->
        <Grid Grid.Column="1" Margin="12" RowDefinitions="*,Auto">

            <!-- OUTPUT GALLERY -->
            <controls:ImageGalleryCard
                DataContext="{Binding ImageGalleryCardViewModel}" />

            <!-- GENERATE BUTTON -->
            <Button
                Grid.Row="1"
                HorizontalAlignment="Right"
                Width="160"
                Height="40"
                Margin="0,12,0,0"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />

        </Grid>

    </Grid>
</UserControl>
