    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO (600px), DESNO (fleksibilno) -->
    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVO: 600x400 Load Image + scroll parametri -->
        <Grid Grid.Column="0" RowDefinitions="400,*" Margin="0,0,12,0">
            
            <!-- LOAD IMAGE AREA (gornji lijevi kut - fiksna veličina) -->
            <Border 
                Width="600" 
                Height="400"
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <controls:SelectImageCard 
                    DataContext="{Binding StackCardViewModel.GetCard<SelectImageCardViewModel>}"
                    Height="400" 
                    Width="600" />
            </Border>
            
            <!-- SCROLLABLE PARAMETRI (donji dio) -->
            <ScrollViewer 
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,0,12">
                <Grid>
                    <!-- Izostavi prvi card (SelectImageCard) -->
                    <ItemsControl 
                        ItemsSource="{Binding StackCardViewModel.Cards}"
                        ItemsPanel="{StaticResource VerticalStackPanelTemplate}"
                        ItemTemplateSelector="{StaticResource CardTemplateSelector}">
                        <ItemsControl.ItemContainerStyle>
                            <Style Selector="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- DESNO: Output i button -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,0,0,12">
            
            <!-- Output gallery (pun prostor gore) -->
            <Border 
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <controls:ImageGalleryCard 
                    DataContext="{Binding ImageGalleryCardViewModel}" />
            </Border>
            
            <!-- Generate button (ispod gallerya) -->
            <Button 
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
