<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="2*,3*" RowDefinitions="*,Auto">

        <!-- Left Panel - StackCard -->
        <ScrollViewer Grid.Column="0" Grid.Row="0">
            <controls:StackCard Margin="12" DataContext="{Binding StackCardViewModel}" />
        </ScrollViewer>

        <!-- Left Panel - Generate Button -->
        <Border Grid.Column="0" Grid.Row="1" Padding="12,0,12,12">
            <Button
                HorizontalAlignment="Left"
                Width="160"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateCommand}" />
        </Border>

        <!-- Right Panel - Image Preview -->
        <Border
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="12"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image
                Width="384"
                Height="384"
                Stretch="Uniform"
                Source="{Binding SelectedImage}" />
        </Border>

    </Grid>
</UserControl>
