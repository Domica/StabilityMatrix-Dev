<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO (600px), DESNO (fleksibilno) -->
    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVO: 600px širina, 400px visina za sliku + scroll parametri -->
        <Grid Grid.Column="0" RowDefinitions="400,*" Margin="0,0,12,0">
            
            <!-- Slika u 600x400 containeru (shrinka se) -->
            <Border 
                Width="600" 
                Height="400"
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image 
                        Source="{Binding SelectedImage}" 
                        Stretch="None" />
                </Viewbox>
            </Border>
            
            <!-- Parametri ispod slike (scrollable) -->
            <ScrollViewer 
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,0,12">
                <controls:StackCard 
                    DataContext="{Binding StackCardViewModel}" />
            </ScrollViewer>
        </Grid>

        <!-- DESNO: Output gore, button dolje -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,0,0,12">
            
            <!-- Output gallery (pun prostor gore) -->
            <Border 
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <controls:ImageGalleryCard 
                    DataContext="{Binding ImageGalleryCardViewModel}" />
            </Border>
            
            <!-- Generate button (ispod gallerya) -->
            <Button 
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
