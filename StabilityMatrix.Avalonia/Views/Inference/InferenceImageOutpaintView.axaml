<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVA STRANA: 600px širina -->
        <StackPanel Grid.Column="0" Width="600" Spacing="12">

            <!-- [LOAD IMAGE] (600x400 fiksno) -->
            <Border Width="600" Height="400"
                    Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="8">
                <Image Source="{Binding SelectedImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="584"
                       MaxHeight="384" />
            </Border>

            <!-- [Outpaint params], [Prompt], [Sampler], [Model], [Seed] -->
            <controls:StackCard DataContext="{Binding StackCardViewModel}" />
        </StackPanel>

        <!-- DESNA STRANA -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- [Output Image] (pun prostor) -->
            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,12">
                <Image Source="{Binding GeneratedImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Border>

            <!-- [Generate Button] (fix ispod outputa) -->
            <Button Grid.Row="1"
                    HorizontalAlignment="Right"
                    Width="160"
                    Height="40"
                    Content="Generate Image"
                    Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
