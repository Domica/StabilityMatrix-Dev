<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"  <!-- ✅ ISPRAVLJENO: UKLONJENI RAZMACI -->
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO 600px, DESNO fleksibilno -->
    <Grid ColumnDefinitions="600,*" Margin="12">

        <!-- LIJEVO: Gornji dio = Load Image (600x400 fiksno), Donji dio = scroll parametri -->
        <Grid Grid.Column="0" RowDefinitions="400,*" Margin="0,0,12,0">
            
            <!-- LOAD IMAGE (gornji lijevi kut - fiksno 600x400) -->
            <Border 
                Width="600" 
                Height="400"
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <ContentControl Content="{Binding StackCardViewModel.Cards[0]}" />
            </Border>
            
            <!-- PARAMETRI (scrollable ispod Load Image-a) -->
            <ScrollViewer 
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <ContentControl Content="{Binding StackCardViewModel.Cards[1]}" />
                    <ContentControl Content="{Binding StackCardViewModel.Cards[2]}" />
                    <ContentControl Content="{Binding StackCardViewModel.Cards[3]}" />
                    <ContentControl Content="{Binding StackCardViewModel.Cards[4]}" />
                    <ContentControl Content="{Binding StackCardViewModel.Cards[5]}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- DESNO: Output gore, button dolje -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,0,0,12">
            
            <!-- Output gallery -->
            <Border 
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8"
                Margin="0,0,0,8">
                <controls:ImageGalleryCard 
                    DataContext="{Binding ImageGalleryCardViewModel}" />
            </Border>
            
            <!-- Generate button (VEĆ TOČNO KORISTI GenerateImageCommand) -->
            <Button 
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />
        </Grid>

    </Grid>
</UserControl>
