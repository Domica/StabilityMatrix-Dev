<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!-- 2 kolone: LIJEVO fiksno, DESNO fleksibilno -->
    <Grid ColumnDefinitions="600,*">

        <!-- LEFT: StackCard (fix širina, scroll ako treba) -->
        <Border Grid.Column="0" Margin="12">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <controls:StackCard
                    DataContext="{Binding StackCardViewModel}" />
            </ScrollViewer>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="1" Margin="12" RowDefinitions="Auto,*,Auto">

            <!-- PREVIEW (fiksan, gore desno) -->
            <Border
                Width="400"
                Height="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">

                <Image
                    Stretch="Uniform"
                    Source="{Binding SelectedImage}" />
            </Border>

            <!-- GALLERY (sredina, puni prostor) -->
            <controls:ImageGalleryCard
                Grid.Row="1"
                Margin="0,12,0,12"
                DataContext="{Binding ImageGalleryCardViewModel}" />

            <!-- GENERATE BUTTON (dolje desno) -->
            <Button
                Grid.Row="2"
                HorizontalAlignment="Right"
                Width="160"
                Height="40"
                Content="Generate Image"
                Command="{Binding GenerateImageCommand}" />

        </Grid>

    </Grid>
</UserControl>
