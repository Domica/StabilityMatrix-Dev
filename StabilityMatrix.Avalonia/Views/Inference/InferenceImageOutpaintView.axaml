<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceImageOutpaintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="inference:InferenceImageOutpaintViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <!-- 2 kolone: lijevo kartice, desno preview+gallery+gumb -->
    <Grid ColumnDefinitions="Auto,*">

        <!-- LEFT: StackCard fiksni container -->
        <ScrollViewer
            Grid.Column="0"
            Margin="12"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Left"
            MaxWidth="520">
            <controls:StackCard
                DataContext="{Binding StackCardViewModel}" />
        </ScrollViewer>

        <!-- RIGHT: unutarnji grid s 3 reda -->
        <Grid Grid.Column="1" Margin="12" RowDefinitions="Auto,*,Auto">

            <!-- TOP RIGHT: Preview -->
            <Border
                Grid.Row="0"
                Width="400"
                Height="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
                <Image
                    Stretch="Uniform"
                    MaxWidth="384"
                    MaxHeight="384"
                    Source="{Binding SelectedImage}" />
            </Border>

            <!-- MIDDLE: Gallery -->
            <Grid Grid.Row="1" Margin="0,12,0,12">
                <controls:ImageGalleryCard
                    DataContext="{Binding ImageGalleryCardViewModel}" />
            </Grid>

            <!-- BOTTOM RIGHT: Generate -->
            <Border Grid.Row="2" Padding="0,0,12,12">
                <Button
                    HorizontalAlignment="Right"
                    Width="160"
                    Height="40"
                    Content="Generate Image"
                    Command="{Binding GenerateImageCommand}" />
            </Border>

        </Grid>
    </Grid>
</UserControl>
